}))

# ========== ÉDITEUR 100K ==========
if p == "/api/edit/list":
files = []
if EDITS.exists():
for f in sorted(EDITS.glob("*.txt"), key=lambda x: x.stat().st_mtime, reverse=True):
try:
st = f.stat()
files.append({
"name": f.stem + ".py" if f.suffix == ".txt" else f.name,
"bytes": st.st_size,
"ts": datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M"),
})
except Exception: pass
return self._send(200, json.dumps({"files": files, "buffer_max": BUFFER_SIZE}))

if p == "/api/edit/load":
name = qs.get("name", [""])[0]
if not name:
return self._send(400, json.dumps({"error": "name manquant"}))
safe = re.sub(r'[^a-zA-Z0-9_.-]', '_', name)
fp = EDITS / (safe + ".txt")
if not fp.exists():
return self._send(404, json.dumps({"error": "fichier introuvable"}))
content = fp.read_text(encoding="utf-8", errors="ignore")
return self._send(200, json.dumps({"name": name, "content": content, "bytes": len(content.encode("utf-8"))}))

return self._send(404, json.dumps({"error": "not found"}))

# ------------------------------------------------------------------------
def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()

if p == "/api/generate":
prompt = data.get("prompt", "").strip()
langage = data.get("langage", "python").lower()
port = int(data.get("port", PORT + 1))
if not prompt:
return self._send(400, json.dumps({"error": "prompt manquant"}))
code = generer_script(prompt, langage, port)
return self._send(200, json.dumps({
"ok": True, "langage": langage, "port": port,
"code": code, "lignes": code.count("\n"),
}, ensure_ascii=False))

# ========== ÉDITEUR 100K ==========
if p == "/api/edit/save":
name = data.get("name", "").strip()
content = data.get("content", "")
if not name:
return self._send(400, json.dumps({"error": "name manquant"}))
bytes_size = len(content.encode("utf-8"))
if bytes_size > BUFFER_SIZE:
return self._send(413, json.dumps({
"error": f"Contenu dépasse 100 000 octets ({bytes_size})",
"bytes": bytes_size, "max": BUFFER_SIZE
}))
safe = re.sub(r'[^a-zA-Z0-9_.-]', '_', name)
fp = EDITS / (safe + ".txt")
fp.write_text(content, encoding="utf-8")
return self._send(200, json.dumps({
"ok": True, "name": name, "bytes": bytes_size, "max": BUFFER_SIZE
}))

if p == "/api/analyze/code":
code = data.get("code", "")
langage = data.get("langage", "python")
if not code:
return self._send(400, json.dumps({"error": "code manquant"}))
if len(code.encode("utf-8")) > BUFFER_SIZE:
return self._send(413, json.dumps({"error": "code dépasse 100k"}))
result = analyser_code(code, langage)
result["ok"] = True
result["langage"] = langage
return self._send(200, json.dumps(result, ensure_ascii=False, default=str))

return self._send(404, json.dumps({"error": "not found"}))


