if p == "/api/kb":
return self._send(200, json.dumps({
"size": KB.size(),
"recent": KB.items[-20:],
}, ensure_ascii=False, default=str))

if p == "/api/search":
q = qs.get("q", [""])[0]
if not q:
return self._send(400, json.dumps({"error": "q manquant"}))
results = search_all_apis(q)
