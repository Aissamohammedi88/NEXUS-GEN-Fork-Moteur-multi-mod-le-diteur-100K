def analyser_code(code: str, langage: str) -> Dict[str, Any]:
if not code:
return {"problemes": [], "metriques": {}}
lignes = code.split("\n")
problemes = []
for pattern, nom, severite in PATTERNS_SECRETS:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
if any(x in ligne.lower() for x in ["example","placeholder","xxx","your_","<","change_me"]):
continue
problemes.append({"type":nom,"severite":severite,"ligne":i,"extrait":ligne.strip()[:120]})
for pattern, nom, severite in PATTERNS_TODO:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
problemes.append({"type":nom,"severite":severite,"ligne":i,"extrait":ligne.strip()[:120]})
lang_key = langage.lower() if langage else ""
if lang_key in PATTERNS_DANGER:
for pattern, nom, severite in PATTERNS_DANGER[lang_key]:
for i, ligne in enumerate(lignes, 1):
if pattern.search(ligne):
stripped = ligne.strip()
if stripped.startswith(("#","//","/*","*","--")): continue
problemes.append({"type":nom,"severite":severite,"ligne":i,"extrait":stripped[:120]})
lignes_vides = sum(1 for l in lignes if not l.strip())
lignes_commentaires = sum(1 for l in lignes if l.strip().startswith(("#","//","/*","*","--","'")))
lignes_code = len(lignes) - lignes_vides - lignes_commentaires
complexite = 1
for l in lignes:
complexite += len(re.findall(r'\b(?:if|elif|else if|for|while|case|when|catch|except)\b', l))
complexite += len(re.findall(r'\?[^:]+:', l))
complexite += len(re.findall(r'&&|\|\|', l))
fonctions = []
for i, l in enumerate(lignes, 1):
m = re.match(r'\s*(?:def|fn|func|function|public|private|protected|static|async|suspend)\s+(\w+)', l)
if m: fonctions.append({"nom":m.group(1),"ligne":i})
for i, l in enumerate(lignes):
if re.search(r'(?:def|fn|func|function)\s+\w+\s*\([^)]*\)\s*(?:->\s*\w+\s*)?\{?\s*$', l.strip()):
suivantes = lignes[i+1:i+3]
if all(not s.strip() or s.strip() in ("pass","return","}","...") for s in suivantes):
problemes.append({"type":"fonction_vide","severite":"medium","ligne":i+1,"extrait":l.strip()[:120]})
return {"problemes":problemes,"metriques":{
"lignes_total":len(lignes),"lignes_vides":lignes_vides,
"lignes_commentaires":lignes_commentaires,"lignes_code":lignes_code,
"complexite_cyclomatique":complexite,"fonctions":len(fonctions),
"fonctions_liste":fonctions[:50],"octets":len(code.encode("utf-8","ignore"))}}


