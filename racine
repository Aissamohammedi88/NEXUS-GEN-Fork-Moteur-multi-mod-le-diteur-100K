def search_all_apis(query: str, max_workers: int = 20) -> Dict[str, Any]:
results = {}
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = {ex.submit(fn, query, 3): name for name, fn in APIS.items()}
for fut in as_completed(futures):
name = futures[fut]
try:
results[name] = fut.result(timeout=15)
except Exception as e:
results[name] = {"error": str(e)[:120]}
return results


