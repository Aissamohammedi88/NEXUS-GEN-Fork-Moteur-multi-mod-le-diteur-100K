class Handler(BaseHTTPRequestHandler):
rbufsize = BUFFER_SIZE
wbufsize = BUFFER_SIZE
def log_message(self, *a): pass
def _send(self, code, body, ctype="application/json"):
try:
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.send_header("X-Buffer-Size", str(BUFFER_SIZE))
self.send_header("X-Editor-Size", str(EDITOR_SIZE))
self.end_headers()
for i in range(0, len(body), BUFFER_SIZE):
self.wfile.write(body[i:i+BUFFER_SIZE])
self.wfile.flush()
except (BrokenPipeError, ConnectionResetError):
pass
def _read_json(self):
try:
n = int(self.headers.get("Content-Length", "0"))
if n > BUFFER_SIZE:
chunks = []
remaining = n
while remaining > 0:
chunk = self.rfile.read(min(BUFFER_SIZE, remaining))
if not chunk: break
chunks.append(chunk); remaining -= len(chunk)
raw = b"".join(chunks)
else:
raw = self.rfile.read(n)
return json.loads(raw.decode("utf-8"))
except Exception:
return {}
def do_GET(self):
p = self.path.split("?")[0]
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

if p in ("/", "/index.html"):
html = (HTML_UI.replace("__V__", VERSION)
.replace("__LANG__", str(len(LANGAGES_SUPPORTES)))
.replace("__EXT__", str(TOTAL_EXTENSIONS))
.replace("__API__", str(len(APIS)))
.replace("__NICHE__", str(len(NICHES)))
.replace("__GEN__", str(len(GENERATEURS)))
.replace("__AUTEUR__", AUTEUR)
.replace("__LIC__", LICENCE))
return self._send(200, html, "text/html")

if p == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "author": AUTEUR,
"port": PORT, "buffer_size": BUFFER_SIZE, "editor_size": EDITOR_SIZE,
"langages": len(LANGAGES_SUPPORTES), "extensions": TOTAL_EXTENSIONS,
"apis": list(APIS.keys()), "niches": len(NICHES), "kb_size": KB.size(),
"generateurs": list(GENERATEURS.keys()),
}))

if p == "/api/buffer":
return self._send(200, json.dumps({
"buffer_size": BUFFER_SIZE, "editor_size": EDITOR_SIZE,
"rbufsize": self.rbufsize, "wbufsize": self.wbufsize,
"status": "✅ Buffer 100 000 octets"
}))

if p == "/api/languages":
return self._send(200, json.dumps({"languages": LANGAGES_SUPPORTES}))

if p == "/api/niches":
return self._send(200, json.dumps({"niches": NICHES}))

if p == "/api/apis":
return self._send(200, json.dumps({"apis": list(APIS.keys())}))

if p == "/api/kb":
return self._send(200, json.dumps({"size": KB.size(), "recent": KB.items[-20:]}, ensure_ascii=False, default=str))

if p == "/api/search":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
results = search_all_apis(q)
return self._send(200, json.dumps({"query": q, "results": results, "count": len(results)}, ensure_ascii=False, default=str))

if p == "/api/ddg":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
results = _ddg(q) + _ddg_html(q)
return self._send(200, json.dumps({"query": q, "results": results, "count": len(results)}, ensure_ascii=False))

if p == "/api/enrich":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
added = enrichir_kb(q)
return self._send(200, json.dumps({"query": q, "added": added, "kb_size": KB.size()}))

return self._send(404, json.dumps({"error": "not found"}))

def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()

if p == "/api/generate":
prompt = data.get("prompt", "").strip()[:EDITOR_SIZE]
langage = data.get("langage", "python").lower()
port = int(data.get("port", 8096))
if not prompt: return self._send(400, json.dumps({"error": "prompt manquant"}))
code = generer_script(prompt, langage, port)
return self._send(200, json.dumps({
"ok": True, "langage": langage, "port": port,
"code": code, "lignes": code.count("\n"),
"buffer": BUFFER_SIZE, "editor": EDITOR_SIZE,
}, ensure_ascii=False))

if p == "/api/analyze":
path = data.get("path", ".")
return self._send(200, json.dumps({
"fichiers_total": 0, "fichiers_analyses": 0,
"stats_globales": {"lignes_total": 0},
"problemes_total": 0, "problemes": [],
"path": path, "note": "Analyse à venir",
}))

return self._send(404, json.dumps({"error": "not found"}))

