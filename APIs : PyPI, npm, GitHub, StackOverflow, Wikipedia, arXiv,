@register_api("duckduckgo-html")
def _ddg_html(q, limit=10):
"""DuckDuckGo HTML scraping — plus de résultats"""
try:
url = f"https://html.duckduckgo.com/html/?q={urllib.parse.quote(q)}"
raw = http_get(url, timeout=12)
if raw.startswith('{"error"'): return []
results = []
# Extraction simple des liens
for m in re.finditer(r'<a[^>]+class="result__a"[^>]+href="([^"]+)"[^>]*>(.*?)</a>', raw, re.DOTALL)[:limit]:
href = m.group(1)
title = re.sub(r"<[^>]+>", "", m.group(2)).strip()
results.append({"title": title[:150], "url": href[:300]})
# Extraction des snippets
for m in re.finditer(r'<a[^>]+class="result__snippet"[^>]*>(.*?)</a>', raw, re.DOTALL)[:limit]:
snippet = re.sub(r"<[^>]+>", "", m.group(1)).strip()
if len(results) > len([r for r in results if "snippet" in r]):
for r in results:
if "snippet" not in r:
r["snippet"] = snippet[:300]
break
return results[:limit]
except Exception as e:
return [{"error": str(e)[:120]}]

def search_all_apis(query, max_workers=20):
results = {}
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = {ex.submit(fn, query, 3): name for name, fn in APIS.items()}
for fut in as_completed(futures):
name = futures[fut]
try: results[name] = fut.result(timeout=15)
except Exception as e: results[name] = {"error": str(e)[:120]}
return results

