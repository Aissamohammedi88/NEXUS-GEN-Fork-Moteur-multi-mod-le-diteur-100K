KNOWLEDGE_FILE = KNOWLEDGE / "knowledge_base.jsonl"

class KnowledgeBase:
def __init__(self):
self.items = []
self.load()
def load(self):
if KNOWLEDGE_FILE.exists():
try:
with open(KNOWLEDGE_FILE, "r", encoding="utf-8") as f:
for line in f:
try: self.items.append(json.loads(line))
except Exception: continue
except Exception: pass
def add(self, item):
self.items.append(item)
try:
with open(KNOWLEDGE_FILE, "a", encoding="utf-8") as f:
f.write(json.dumps(item, ensure_ascii=False) + "\n")
except Exception: pass
def size(self): return len(self.items)
def search(self, query, limit=20):
q = query.lower()
out = []
for item in self.items:
if q in json.dumps(item, ensure_ascii=False).lower():
out.append(item)
if len(out) >= limit: break
return out

KB = KnowledgeBase()

def enrichir_kb(query):
results = search_all_apis(query)
count = 0
for api_name, items in results.items():
if not isinstance(items, list): continue
for item in items:
if not isinstance(item, dict): continue
KB.add({"source": api_name, "query": query, "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(), "data": item})
count += 1
return count

